PREFIX c: <https://curricula.live/id/formal-sciences/concept/>
PREFIX v: <https://curricula.live/id/formal-sciences/vocab/>
PREFIX g: <https://curricula.live/id/formal-sciences/graph/>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX dct: <http://purl.org/dc/terms/>
PREFIX prov: <http://www.w3.org/ns/prov#>
SELECT ?representation ?number ?declaration
WHERE {
  GRAPH g:alignments {
    ?representation rdfs:seeAlso <http://cll.niimm.ksu.ru/ontologies/mathematics#E3298> .
  }
  GRAPH g:asserted { ?representation v:represents ?number }
  GRAPH g:provenance {
    ?number dct:source <http://cll.niimm.ksu.ru/ontologies/mathematics#E2127> .
    ?claim rdf:subject ?representation ; rdf:predicate v:represents ; rdf:object ?number ;
       prov:wasDerivedFrom ?witness .
    ?witness dct:type "Lean declaration" ; dct:title ?declaration .
  }
}
