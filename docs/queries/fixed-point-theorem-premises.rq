PREFIX c: <https://curricula.live/id/formal-sciences/concept/>
PREFIX v: <https://curricula.live/id/formal-sciences/vocab/>
PREFIX g: <https://curricula.live/id/formal-sciences/graph/>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX dct: <http://purl.org/dc/terms/>
PREFIX prov: <http://www.w3.org/ns/prov#>

SELECT ?premise ?result ?formerPredicate
WHERE {
  GRAPH g:asserted {
    c:knaster-tarski-fixed-point-theorem v:requiresPremise ?premise ; v:guarantees ?result .
  }
  GRAPH g:provenance {
    ?claim rdf:subject c:knaster-tarski-fixed-point-theorem ; rdf:predicate v:requiresPremise ;
      rdf:object ?premise ; prov:wasRevisionOf ?former .
    ?former rdf:predicate ?formerPredicate ; dct:type "superseded interpretation" .
  }
}
ORDER BY ?premise
