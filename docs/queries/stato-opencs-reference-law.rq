PREFIX c: <https://curricula.live/id/formal-sciences/concept/>
PREFIX v: <https://curricula.live/id/formal-sciences/vocab/>
PREFIX g: <https://curricula.live/id/formal-sciences/graph/>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX prov: <http://www.w3.org/ns/prov#>
PREFIX dct: <http://purl.org/dc/terms/>

SELECT ?test ?distribution ?nativeTest ?nativeDistribution ?axiom
WHERE {
  GRAPH g:alignments { ?test skos:exactMatch <https://w3id.org/ocs/ont/C15792> }
  GRAPH g:asserted { ?test v:usesReferenceDistribution ?distribution }
  GRAPH g:provenance {
    ?statement rdf:subject ?test ; rdf:predicate v:usesReferenceDistribution ;
      rdf:object ?distribution ; prov:wasDerivedFrom ?witness .
    ?witness rdf:subject ?nativeTest ; rdf:object ?nativeDistribution ;
      dct:type ?axiom .
  }
}
