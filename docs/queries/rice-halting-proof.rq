PREFIX c: <https://curricula.live/id/formal-sciences/concept/>
PREFIX v: <https://curricula.live/id/formal-sciences/vocab/>
PREFIX g: <https://curricula.live/id/formal-sciences/graph/>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX dct: <http://purl.org/dc/terms/>
PREFIX prov: <http://www.w3.org/ns/prov#>
SELECT ?proof ?theorem ?undecidability ?declaration ?textualReference
WHERE {
  GRAPH g:asserted {
    c:fixed-input-halting v:hasProperty ?undecidability .
    ?proof v:proves ?undecidability ; v:uses ?theorem .
  }
  GRAPH g:provenance {
    ?claim rdf:subject ?proof ; rdf:predicate v:uses ; rdf:object ?theorem ;
      prov:wasDerivedFrom ?witness .
    ?witness dct:type "Lean declaration" ; dct:title ?declaration ;
      v:sourceLexicalProofReference ?textualReference .
  }
}
