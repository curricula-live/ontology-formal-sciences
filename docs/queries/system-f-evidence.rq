PREFIX c: <https://curricula.live/id/formal-sciences/concept/>
PREFIX v: <https://curricula.live/id/formal-sciences/vocab/>
PREFIX g: <https://curricula.live/id/formal-sciences/graph/>
PREFIX skos: <http://www.w3.org/2004/02/skos/core#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX dct: <http://purl.org/dc/terms/>

SELECT ?system ?property ?source
WHERE {
  GRAPH g:alignments { ?system skos:exactMatch <https://w3id.org/ocs/ont/C16537> }
  GRAPH g:asserted { ?system v:hasProperty ?property }
  GRAPH g:provenance {
    ?statement rdf:subject ?system ; rdf:predicate v:hasProperty ;
      rdf:object ?property ; dct:source ?source .
  }
}
ORDER BY ?property
