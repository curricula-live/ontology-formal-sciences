PREFIX c: <https://curricula.live/id/formal-sciences/concept/>
PREFIX v: <https://curricula.live/id/formal-sciences/vocab/>
PREFIX g: <https://curricula.live/id/formal-sciences/graph/>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX dct: <http://purl.org/dc/terms/>
PREFIX prov: <http://www.w3.org/ns/prov#>
SELECT ?law ?ingredient ?declaration ?extraction
WHERE {
  GRAPH g:asserted {
    c:stato-0000330 v:hasProperty ?law .
    ?law v:uses ?ingredient .
  }
  GRAPH g:provenance {
    ?claim rdf:subject ?law ; rdf:predicate v:uses ; rdf:object ?ingredient ;
      prov:wasDerivedFrom ?witness .
    ?witness dct:title ?declaration ; dct:type "Lean declaration" ;
      v:evidenceExtraction ?extraction .
  }
}
ORDER BY ?ingredient
