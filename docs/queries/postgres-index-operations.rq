PREFIX c: <https://curricula.live/id/formal-sciences/concept/>
PREFIX v: <https://curricula.live/id/formal-sciences/vocab/>
PREFIX g: <https://curricula.live/id/formal-sciences/graph/>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX dct: <http://purl.org/dc/terms/>
PREFIX prov: <http://www.w3.org/ns/prov#>

SELECT ?index ?operation ?source
WHERE {
  VALUES ?index { c:postgres-btree-index c:postgres-hash-index }
  GRAPH g:asserted { ?index v:supportsOperation ?operation }
  GRAPH g:provenance {
    ?claim rdf:subject ?index ; rdf:predicate v:supportsOperation ;
      rdf:object ?operation ; dct:source ?source .
  }
}
ORDER BY ?index ?operation
