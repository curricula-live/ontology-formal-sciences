PREFIX c: <https://curricula.live/id/formal-sciences/concept/>
PREFIX v: <https://curricula.live/id/formal-sciences/vocab/>
PREFIX g: <https://curricula.live/id/formal-sciences/graph/>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX dct: <http://purl.org/dc/terms/>
PREFIX prov: <http://www.w3.org/ns/prov#>
SELECT ?role ?input ?nativePredicate ?axiom
WHERE {
  VALUES ?role { v:uses v:usesReferenceDistribution }
  GRAPH g:asserted { c:stato-0000304 ?role ?input }
  GRAPH g:provenance {
    ?claim rdf:subject c:stato-0000304 ; rdf:predicate ?role ; rdf:object ?input ;
        prov:wasDerivedFrom ?evidence .
    ?evidence rdf:predicate ?nativePredicate ; dct:type ?axiom .
  }
}
ORDER BY ?role
