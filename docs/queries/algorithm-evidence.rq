PREFIX c: <https://curricula.live/id/formal-sciences/concept/>
PREFIX v: <https://curricula.live/id/formal-sciences/vocab/>
PREFIX g: <https://curricula.live/id/formal-sciences/graph/>
PREFIX dct: <http://purl.org/dc/terms/>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>

# Which source supports the use of a graph structure by the 2-SAT decision procedure?
SELECT ?ingredient ?reference WHERE {
  GRAPH g:asserted { c:two-sat-implication-graph-algorithm v:uses ?ingredient }
  GRAPH g:provenance {
    ?assertion rdf:subject c:two-sat-implication-graph-algorithm ;
               rdf:predicate v:uses ; rdf:object ?ingredient ; dct:source ?reference .
  }
} ORDER BY ?ingredient ?reference
