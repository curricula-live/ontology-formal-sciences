PREFIX c: <https://curricula.live/id/formal-sciences/concept/>
PREFIX v: <https://curricula.live/id/formal-sciences/vocab/>
PREFIX g: <https://curricula.live/id/formal-sciences/graph/>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX dct: <http://purl.org/dc/terms/>
PREFIX prov: <http://www.w3.org/ns/prov#>

SELECT ?analysis ?property ?source
WHERE {
  GRAPH g:asserted {
    c:llvm-loop-invariant-code-motion v:uses ?analysis .
    ?analysis v:analyzes ?property .
  }
  GRAPH g:provenance {
    ?claim rdf:subject c:llvm-loop-invariant-code-motion ;
      rdf:predicate v:uses ; rdf:object ?analysis ; dct:source ?source .
  }
}
ORDER BY ?property
