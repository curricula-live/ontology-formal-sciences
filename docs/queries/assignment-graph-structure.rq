PREFIX c: <https://curricula.live/id/formal-sciences/concept/>
PREFIX g: <https://curricula.live/id/formal-sciences/graph/>
PREFIX v: <https://curricula.live/id/formal-sciences/vocab/>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX dct: <http://purl.org/dc/terms/>

SELECT ?method ?problem ?structure ?methodReference ?structureReference
WHERE {
  GRAPH g:asserted {
    ?method v:solves ?problem .
    ?problem v:hasInputStructure ?structure .
    VALUES ?problem { c:assignment-problem }
  }
  GRAPH g:provenance {
    ?methodClaim rdf:subject ?method ; rdf:predicate v:solves ;
      rdf:object ?problem ; dct:source ?methodReference .
    ?structureClaim rdf:subject ?problem ; rdf:predicate v:hasInputStructure ;
      rdf:object ?structure ; dct:source ?structureReference .
  }
}
