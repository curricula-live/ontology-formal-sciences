PREFIX c: <https://curricula.live/id/formal-sciences/concept/>
PREFIX v: <https://curricula.live/id/formal-sciences/vocab/>
PREFIX g: <https://curricula.live/id/formal-sciences/graph/>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX dct: <http://purl.org/dc/terms/>

SELECT ?method ?structure ?reference
WHERE {
  GRAPH g:asserted {
    ?method v:solves c:ground-euf-satisfiability ;
            v:computes c:congruence-closure ;
            v:uses ?structure .
    ?structure <http://www.w3.org/2004/02/skos/core#inScheme>
        <https://curricula.live/id/formal-sciences/scheme/computer-science> .
  }
  GRAPH g:provenance {
    ?statement rdf:subject ?method ;
               rdf:predicate v:uses ;
               rdf:object ?structure ;
               dct:source ?reference .
  }
}
ORDER BY ?method ?structure ?reference
