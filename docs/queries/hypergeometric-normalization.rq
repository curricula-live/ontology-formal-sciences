PREFIX c: <https://curricula.live/id/formal-sciences/concept/>
PREFIX v: <https://curricula.live/id/formal-sciences/vocab/>
PREFIX g: <https://curricula.live/id/formal-sciences/graph/>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX dct: <http://purl.org/dc/terms/>
PREFIX prov: <http://www.w3.org/ns/prov#>

SELECT ?normalization ?identity ?declaration ?proof ?digest
WHERE {
  GRAPH g:asserted {
    c:stato-0000060 v:hasProperty ?normalization .
    ?normalization v:uses ?identity .
  }
  GRAPH g:provenance {
    ?claim rdf:subject ?normalization ; rdf:predicate v:uses ;
      rdf:object ?identity ; prov:wasDerivedFrom ?evidence .
    ?evidence dct:type "Lean declaration" ; dct:title ?declaration ;
      prov:hadPrimarySource ?proof ; v:evidenceContentDigest ?digest .
  }
}
ORDER BY ?normalization ?identity ?declaration
