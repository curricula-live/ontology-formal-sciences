PREFIX c: <https://curricula.live/id/formal-sciences/concept/>
PREFIX v: <https://curricula.live/id/formal-sciences/vocab/>
PREFIX g: <https://curricula.live/id/formal-sciences/graph/>
PREFIX mls: <http://www.w3.org/ns/mls#>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX dct: <http://purl.org/dc/terms/>
PREFIX prov: <http://www.w3.org/ns/prov#>

SELECT ?evaluation ?measure ?outputPredicate ?measurePredicate
WHERE {
  GRAPH g:asserted {
    c:mls-run v:documentsEvaluationOutput ?evaluation .
    ?evaluation v:reportsEvaluationMeasure ?measure .
  }
  GRAPH g:provenance {
    ?outputClaim rdf:subject c:mls-run ; rdf:predicate v:documentsEvaluationOutput ;
      rdf:object ?evaluation ; prov:wasDerivedFrom ?outputAxiom .
    ?outputAxiom rdf:subject mls:Run ; rdf:predicate ?outputPredicate ;
      rdf:object mls:ModelEvaluation ; dct:type "subclass-some" .
    ?measureClaim rdf:subject ?evaluation ; rdf:predicate v:reportsEvaluationMeasure ;
      rdf:object ?measure ; prov:wasDerivedFrom ?measureAxiom .
    ?measureAxiom rdf:subject mls:ModelEvaluation ; rdf:predicate ?measurePredicate ;
      rdf:object mls:EvaluationMeasure ; dct:type "subclass-some" .
  }
}
