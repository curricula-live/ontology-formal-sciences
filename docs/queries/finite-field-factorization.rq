PREFIX c: <https://curricula.live/id/formal-sciences/concept/>
PREFIX v: <https://curricula.live/id/formal-sciences/vocab/>
PREFIX g: <https://curricula.live/id/formal-sciences/graph/>
PREFIX dct: <http://purl.org/dc/terms/>

SELECT ?method ?assumption ?problem ?source
WHERE {
  GRAPH g:asserted {
    ?method v:solves ?problem ;
            v:requiresAssumption ?assumption ;
            v:uses c:finite-field .
    VALUES ?problem { c:equal-degree-polynomial-factorization }
  }
  GRAPH g:provenance { ?method dct:source ?source }
}
ORDER BY ?method ?assumption ?problem ?source
