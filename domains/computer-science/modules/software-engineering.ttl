@prefix c: <https://curricula.live/id/formal-sciences/concept/> .
@prefix v: <https://curricula.live/id/formal-sciences/vocab/> .
@prefix scheme: <https://curricula.live/id/formal-sciences/scheme/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

c:software-engineering a skos:Concept ; skos:prefLabel "Software engineering"@en ;
    skos:inScheme scheme:computer-science ; skos:broader c:computer-science .

c:software-testing a skos:Concept ; skos:prefLabel "Software testing"@en ;
    skos:inScheme scheme:computer-science ; skos:broader c:software-engineering .

c:version-control a skos:Concept ; skos:prefLabel "Version control"@en ;
    skos:inScheme scheme:computer-science ; skos:broader c:software-engineering .

c:static-program-analysis a skos:Concept ; skos:prefLabel "Static program analysis"@en ;
    skos:inScheme scheme:computer-science ; skos:broader c:software-engineering .

c:software-specification a skos:Concept ; skos:prefLabel "Software specification"@en ;
    skos:inScheme scheme:computer-science ; skos:broader c:software-engineering .
