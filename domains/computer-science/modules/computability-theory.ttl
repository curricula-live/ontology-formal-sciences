@prefix c: <https://curricula.live/id/formal-sciences/concept/> .
@prefix v: <https://curricula.live/id/formal-sciences/vocab/> .
@prefix scheme: <https://curricula.live/id/formal-sciences/scheme/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

c:computability-theory a skos:Concept ; skos:prefLabel "Computability theory"@en ;
    skos:inScheme scheme:computer-science ; skos:broader c:computer-science .

c:turing-machine a skos:Concept ; skos:prefLabel "Turing machine"@en ;
    skos:inScheme scheme:computer-science ; skos:broader c:computability-theory .

c:halting-problem a skos:Concept ; skos:prefLabel "Halting problem"@en ;
    skos:inScheme scheme:computer-science ; skos:broader c:computability-theory .

c:decidability a skos:Concept ; skos:prefLabel "Decidability"@en ;
    skos:inScheme scheme:computer-science ; skos:broader c:computability-theory .

c:computably-enumerable-set a skos:Concept ; skos:prefLabel "Computably enumerable set"@en ;
    skos:inScheme scheme:computer-science ; skos:broader c:computability-theory .
