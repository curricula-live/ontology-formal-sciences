@prefix c: <https://curricula.live/id/formal-sciences/concept/> .
@prefix v: <https://curricula.live/id/formal-sciences/vocab/> .
@prefix scheme: <https://curricula.live/id/formal-sciences/scheme/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

c:foundations-of-computing a skos:Concept ; skos:prefLabel "Foundations of computing"@en ;
    skos:inScheme scheme:computer-science ; skos:broader c:computer-science .

c:algorithm a skos:Concept ; skos:prefLabel "Algorithm"@en ;
    skos:inScheme scheme:computer-science ; skos:broader c:foundations-of-computing .

c:computational-problem a skos:Concept ; skos:prefLabel "Computational problem"@en ;
    skos:inScheme scheme:computer-science ; skos:broader c:foundations-of-computing .

c:abstract-machine a skos:Concept ; skos:prefLabel "Abstract machine"@en ;
    skos:inScheme scheme:computer-science ; skos:broader c:foundations-of-computing .

c:representation-invariant a skos:Concept ; skos:prefLabel "Representation invariant"@en ;
    skos:inScheme scheme:computer-science ; skos:broader c:foundations-of-computing .
