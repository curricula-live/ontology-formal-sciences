@prefix c: <https://curricula.live/id/formal-sciences/concept/> .
@prefix v: <https://curricula.live/id/formal-sciences/vocab/> .
@prefix scheme: <https://curricula.live/id/formal-sciences/scheme/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

c:computer-networks a skos:Concept ; skos:prefLabel "Computer networks"@en ;
    skos:inScheme scheme:computer-science ; skos:broader c:computer-science .

c:packet-switching a skos:Concept ; skos:prefLabel "Packet switching"@en ;
    skos:inScheme scheme:computer-science ; skos:broader c:computer-networks .

c:routing-protocol a skos:Concept ; skos:prefLabel "Routing protocol"@en ;
    skos:inScheme scheme:computer-science ; skos:broader c:computer-networks .

c:congestion-control a skos:Concept ; skos:prefLabel "Congestion control"@en ;
    skos:inScheme scheme:computer-science ; skos:broader c:computer-networks .

c:network-topology a skos:Concept ; skos:prefLabel "Network topology"@en ;
    skos:inScheme scheme:computer-science ; skos:broader c:computer-networks .
