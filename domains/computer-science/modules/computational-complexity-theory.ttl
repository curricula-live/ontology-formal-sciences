@prefix c: <https://curricula.live/id/formal-sciences/concept/> .
@prefix v: <https://curricula.live/id/formal-sciences/vocab/> .
@prefix scheme: <https://curricula.live/id/formal-sciences/scheme/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

c:computational-complexity-theory a skos:Concept ; skos:prefLabel "Computational complexity theory"@en ;
    skos:inScheme scheme:computer-science ; skos:broader c:computer-science .

c:polynomial-time a skos:Concept ; skos:prefLabel "Polynomial time"@en ;
    skos:inScheme scheme:computer-science ; skos:broader c:computational-complexity-theory .

c:np-completeness a skos:Concept ; skos:prefLabel "NP-completeness"@en ;
    skos:inScheme scheme:computer-science ; skos:broader c:computational-complexity-theory .

c:polynomial-time-reduction a skos:Concept ; skos:prefLabel "Polynomial-time reduction"@en ;
    skos:inScheme scheme:computer-science ; skos:broader c:computational-complexity-theory .

c:space-complexity a skos:Concept ; skos:prefLabel "Space complexity"@en ;
    skos:inScheme scheme:computer-science ; skos:broader c:computational-complexity-theory .
