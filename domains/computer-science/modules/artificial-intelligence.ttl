@prefix c: <https://curricula.live/id/formal-sciences/concept/> .
@prefix v: <https://curricula.live/id/formal-sciences/vocab/> .
@prefix scheme: <https://curricula.live/id/formal-sciences/scheme/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

c:artificial-intelligence a skos:Concept ; skos:prefLabel "Artificial intelligence"@en ;
    skos:inScheme scheme:computer-science ; skos:broader c:computer-science .

c:heuristic-search a skos:Concept ; skos:prefLabel "Heuristic search"@en ;
    skos:inScheme scheme:computer-science ; skos:broader c:artificial-intelligence .

c:a-star-search a skos:Concept ; skos:prefLabel "A-star search"@en ;
    skos:inScheme scheme:computer-science ; skos:broader c:heuristic-search, c:artificial-intelligence ;
    skos:definition "Best-first shortest-path search that orders candidate states by path cost so far plus a heuristic estimate of remaining cost. The reviewed graph-search guarantee assumes nonnegative edge weights, a fixed admissible heuristic with zero at the target, and reopening on improved cost."@en .

c:knowledge-representation a skos:Concept ; skos:prefLabel "Knowledge representation"@en ;
    skos:inScheme scheme:computer-science ; skos:broader c:artificial-intelligence .

c:automated-planning a skos:Concept ; skos:prefLabel "Automated planning"@en ;
    skos:inScheme scheme:computer-science ; skos:broader c:artificial-intelligence .

c:sum-product-algorithm a skos:Concept ; skos:prefLabel "Sum-product algorithm"@en ;
    skos:inScheme scheme:computer-science ; skos:broader c:artificial-intelligence ;
    skos:definition "Message passing on a factor graph that computes exact marginals on a tree. Loopy applications can be approximate."@en .

c:factor-graph a skos:Concept ; skos:prefLabel "Factor graph"@en ;
    skos:inScheme scheme:computer-science ; skos:broader c:artificial-intelligence ;
    skos:definition "A bipartite graph whose two types of nodes represent variables and factors in a product decomposition of a function."@en .

c:tree-sum-product a skos:Concept ; skos:prefLabel "Sum-product inference on a tree"@en ;
    skos:inScheme scheme:computer-science ; skos:broader c:sum-product-algorithm ;
    skos:definition "Sum-product message passing on an acyclic factor graph. For a normalizable probability model, normalizing the resulting beliefs yields the exact variable marginals."@en .
