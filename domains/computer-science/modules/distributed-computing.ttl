@prefix c: <https://curricula.live/id/formal-sciences/concept/> .
@prefix v: <https://curricula.live/id/formal-sciences/vocab/> .
@prefix scheme: <https://curricula.live/id/formal-sciences/scheme/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

c:distributed-computing a skos:Concept ; skos:prefLabel "Distributed computing"@en ;
    skos:inScheme scheme:computer-science ; skos:broader c:computer-science .

c:distributed-consensus a skos:Concept ; skos:prefLabel "Distributed consensus"@en ;
    skos:inScheme scheme:computer-science ; skos:broader c:distributed-computing .

c:logical-clock a skos:Concept ; skos:prefLabel "Logical clock"@en ;
    skos:inScheme scheme:computer-science ; skos:broader c:distributed-computing .

c:causal-consistency a skos:Concept ; skos:prefLabel "Causal consistency"@en ;
    skos:inScheme scheme:computer-science ; skos:broader c:distributed-computing .

c:state-machine-replication a skos:Concept ; skos:prefLabel "State machine replication"@en ;
    skos:inScheme scheme:computer-science ; skos:broader c:distributed-computing .
