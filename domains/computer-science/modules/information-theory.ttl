@prefix c: <https://curricula.live/id/formal-sciences/concept/> .
@prefix v: <https://curricula.live/id/formal-sciences/vocab/> .
@prefix scheme: <https://curricula.live/id/formal-sciences/scheme/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

c:information-theory a skos:Concept ; skos:prefLabel "Information theory"@en ;
    skos:inScheme scheme:computer-science ; skos:broader c:computer-science .

c:shannon-entropy a skos:Concept ; skos:prefLabel "Shannon entropy"@en ;
    skos:inScheme scheme:computer-science ; skos:broader c:information-theory .

c:mutual-information a skos:Concept ; skos:prefLabel "Mutual information"@en ;
    skos:inScheme scheme:computer-science ; skos:broader c:information-theory .

c:channel-capacity a skos:Concept ; skos:prefLabel "Channel capacity"@en ;
    skos:inScheme scheme:computer-science ; skos:broader c:information-theory .

c:source-coding-theorem a skos:Concept ; skos:prefLabel "Source coding theorem"@en ;
    skos:inScheme scheme:computer-science ; skos:broader c:information-theory .

c:entropy-coding a skos:Concept ; skos:prefLabel "Entropy coding"@en ;
    skos:inScheme scheme:computer-science ; skos:broader c:information-theory .

c:huffman-coding a skos:Concept ; skos:prefLabel "Huffman coding"@en ;
    skos:inScheme scheme:computer-science ; skos:broader c:information-theory .
