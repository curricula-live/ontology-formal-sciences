@prefix c: <https://curricula.live/id/formal-sciences/concept/> .
@prefix v: <https://curricula.live/id/formal-sciences/vocab/> .
@prefix scheme: <https://curricula.live/id/formal-sciences/scheme/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

c:dijkstra-s-algorithm v:uses c:edge-relaxation .
c:bellman-ford-algorithm v:uses c:edge-relaxation .
c:finite-automaton v:recognizesExactly c:regular-language .
c:nondeterministic-pushdown-automaton v:recognizesExactly c:context-free-language .
c:nondeterministic-pushdown-automaton v:uses c:stack-data-structure .
c:sum-product-algorithm v:uses c:factor-graph .
c:conditional-mutual-information v:uses c:kullback-leibler-divergence .
c:mutual-information v:uses c:kullback-leibler-divergence .
c:tree-sum-product v:uses c:factor-graph .
c:nondeterministic-pushdown-automaton skos:broader c:pushdown-automaton .
