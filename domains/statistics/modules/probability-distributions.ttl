@prefix c: <https://curricula.live/id/formal-sciences/concept/> .
@prefix v: <https://curricula.live/id/formal-sciences/vocab/> .
@prefix scheme: <https://curricula.live/id/formal-sciences/scheme/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

c:probability-distributions a skos:Concept ; skos:prefLabel "Probability distributions"@en ;
    skos:inScheme scheme:statistics ; skos:broader c:statistics .

c:normal-distribution a skos:Concept ; skos:prefLabel "Normal distribution"@en ;
    skos:inScheme scheme:statistics ; skos:broader c:probability-distributions .

c:bernoulli-distribution a skos:Concept ; skos:prefLabel "Bernoulli distribution"@en ;
    skos:inScheme scheme:statistics ; skos:broader c:probability-distributions .

c:poisson-distribution a skos:Concept ; skos:prefLabel "Poisson distribution"@en ;
    skos:inScheme scheme:statistics ; skos:broader c:probability-distributions .

c:cumulative-distribution-function a skos:Concept ; skos:prefLabel "Cumulative distribution function"@en ;
    skos:inScheme scheme:statistics ; skos:broader c:probability-distributions .
