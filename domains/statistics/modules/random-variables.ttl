@prefix c: <https://curricula.live/id/formal-sciences/concept/> .
@prefix v: <https://curricula.live/id/formal-sciences/vocab/> .
@prefix scheme: <https://curricula.live/id/formal-sciences/scheme/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

c:random-variables a skos:Concept ; skos:prefLabel "Random variables"@en ;
    skos:inScheme scheme:statistics ; skos:broader c:statistics .

c:random-variable a skos:Concept ; skos:prefLabel "Random variable"@en ;
    skos:inScheme scheme:statistics ; skos:broader c:random-variables .

c:expected-value a skos:Concept ; skos:prefLabel "Expected value"@en ;
    skos:inScheme scheme:statistics ; skos:broader c:random-variables .

c:variance a skos:Concept ; skos:prefLabel "Variance"@en ;
    skos:inScheme scheme:statistics ; skos:broader c:random-variables .

c:covariance a skos:Concept ; skos:prefLabel "Covariance"@en ;
    skos:inScheme scheme:statistics ; skos:broader c:random-variables .
