@prefix c: <https://curricula.live/id/formal-sciences/concept/> .
@prefix v: <https://curricula.live/id/formal-sciences/vocab/> .
@prefix scheme: <https://curricula.live/id/formal-sciences/scheme/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

c:ordinary-least-squares v:uses c:design-matrix .
c:ridge-regression v:uses c:design-matrix .
c:ordinary-least-squares v:uses c:least-squares-residual .
c:principal-component-analysis v:uses c:covariance-matrix .
c:gibbs-sampling v:uses c:full-conditional-distribution .
c:gibbs-sampling v:uses c:markov-chain .
c:markov-chain-monte-carlo v:uses c:stationary-distribution .
c:exponential-distribution v:hasProperty c:memorylessness .
c:geometric-distribution v:hasProperty c:memorylessness .
c:gibbs-sampling skos:broader c:markov-chain-monte-carlo .
c:ordinary-least-squares skos:broader c:least-squares .
c:least-squares-residual skos:broader c:residual-statistics .
c:full-conditional-distribution skos:broader c:conditional-distribution .
