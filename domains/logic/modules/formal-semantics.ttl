@prefix c: <https://curricula.live/id/formal-sciences/concept/> .
@prefix v: <https://curricula.live/id/formal-sciences/vocab/> .
@prefix scheme: <https://curricula.live/id/formal-sciences/scheme/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

c:formal-semantics a skos:Concept ; skos:prefLabel "Formal semantics"@en ;
    skos:inScheme scheme:logic ; skos:broader c:logic .

c:denotational-semantics a skos:Concept ; skos:prefLabel "Denotational semantics"@en ;
    skos:inScheme scheme:logic ; skos:broader c:formal-semantics .

c:axiomatic-semantics a skos:Concept ; skos:prefLabel "Axiomatic semantics"@en ;
    skos:inScheme scheme:logic ; skos:broader c:formal-semantics .

c:fixed-point-semantics a skos:Concept ; skos:prefLabel "Fixed-point semantics"@en ;
    skos:inScheme scheme:logic ; skos:broader c:formal-semantics ;
    skos:definition "An interpretation of recursion or iteration as a fixed point of a semantic functional. Where an ordered-domain construction supplies a least fixed point, it selects the least solution in that order."@en .

c:semantic-entailment a skos:Concept ; skos:prefLabel "Semantic entailment"@en ;
    skos:inScheme scheme:logic ; skos:broader c:formal-semantics .
