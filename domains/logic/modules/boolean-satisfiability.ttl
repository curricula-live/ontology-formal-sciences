@prefix c: <https://curricula.live/id/formal-sciences/concept/> .
@prefix v: <https://curricula.live/id/formal-sciences/vocab/> .
@prefix scheme: <https://curricula.live/id/formal-sciences/scheme/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

c:boolean-satisfiability a skos:Concept ; skos:prefLabel "Boolean satisfiability"@en ;
    skos:inScheme scheme:logic ; skos:broader c:logic .

c:sat-solver a skos:Concept ; skos:prefLabel "SAT solver"@en ;
    skos:inScheme scheme:logic ; skos:broader c:boolean-satisfiability .

c:dpll-algorithm a skos:Concept ; skos:prefLabel "DPLL algorithm"@en ;
    skos:inScheme scheme:logic ; skos:broader c:boolean-satisfiability .

c:unit-propagation a skos:Concept ; skos:prefLabel "Unit propagation"@en ;
    skos:inScheme scheme:logic ; skos:broader c:boolean-satisfiability .

c:conflict-driven-clause-learning a skos:Concept ; skos:prefLabel "Conflict-driven clause learning"@en ;
    skos:inScheme scheme:logic ; skos:broader c:boolean-satisfiability .

c:unit-propagation skos:definition "In a conjunction of clauses under a partial assignment, repeatedly assign the remaining literal of a unit clause to true and simplify the clauses."@en .

c:clause-learning a skos:Concept ; skos:prefLabel "Clause learning"@en ;
    skos:inScheme scheme:logic ; skos:broader c:boolean-satisfiability .
