@prefix c: <https://curricula.live/id/formal-sciences/concept/> .
@prefix v: <https://curricula.live/id/formal-sciences/vocab/> .
@prefix scheme: <https://curricula.live/id/formal-sciences/scheme/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

c:graph-theory a skos:Concept ; skos:prefLabel "Graph theory"@en ;
    skos:inScheme scheme:mathematics ; skos:broader c:mathematics .

c:graph-graph-theory a skos:Concept ; skos:prefLabel "Graph (graph theory)"@en ;
    skos:inScheme scheme:mathematics ; skos:broader c:graph-theory .

c:directed-graph a skos:Concept ; skos:prefLabel "Directed graph"@en ;
    skos:inScheme scheme:mathematics ; skos:broader c:graph-theory .

c:directed-acyclic-graph a skos:Concept ; skos:prefLabel "Directed acyclic graph"@en ;
    skos:inScheme scheme:mathematics ; skos:broader c:graph-theory .

c:weighted-graph a skos:Concept ; skos:prefLabel "Weighted graph"@en ;
    skos:inScheme scheme:mathematics ; skos:broader c:graph-theory .

c:path-graph-theory a skos:Concept ; skos:prefLabel "Path (graph theory)"@en ;
    skos:inScheme scheme:mathematics ; skos:broader c:graph-theory .

c:tree-graph-theory a skos:Concept ; skos:prefLabel "Tree (graph theory)"@en ;
    skos:inScheme scheme:mathematics ; skos:broader c:graph-theory .

c:directed-acyclic-graph skos:definition "A directed graph that contains no directed cycle."@en .

c:adjacency-matrix a skos:Concept ; skos:prefLabel "Adjacency matrix"@en ;
    skos:inScheme scheme:mathematics ; skos:broader c:graph-theory .

c:adjacency-list a skos:Concept ; skos:prefLabel "Adjacency list"@en ;
    skos:inScheme scheme:mathematics ; skos:broader c:graph-theory .

c:graph-laplacian a skos:Concept ; skos:prefLabel "Graph Laplacian"@en ;
    skos:inScheme scheme:mathematics ; skos:broader c:graph-theory .

c:bipartite-graph a skos:Concept ; skos:prefLabel "Bipartite graph"@en ;
    skos:inScheme scheme:mathematics ; skos:broader c:graph-theory .

c:spanning-tree a skos:Concept ; skos:prefLabel "Spanning tree"@en ;
    skos:inScheme scheme:mathematics ; skos:broader c:graph-theory .

c:graph-coloring a skos:Concept ; skos:prefLabel "Graph coloring"@en ;
    skos:inScheme scheme:mathematics ; skos:broader c:graph-theory .
