@prefix c: <https://curricula.live/id/formal-sciences/concept/> .
@prefix v: <https://curricula.live/id/formal-sciences/vocab/> .
@prefix scheme: <https://curricula.live/id/formal-sciences/scheme/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

c:calculus a skos:Concept ; skos:prefLabel "Calculus"@en ;
    skos:inScheme scheme:mathematics ; skos:broader c:mathematics .

c:derivative a skos:Concept ; skos:prefLabel "Derivative"@en ;
    skos:inScheme scheme:mathematics ; skos:broader c:calculus .

c:definite-integral a skos:Concept ; skos:prefLabel "Definite integral"@en ;
    skos:inScheme scheme:mathematics ; skos:broader c:calculus .

c:partial-derivative a skos:Concept ; skos:prefLabel "Partial derivative"@en ;
    skos:inScheme scheme:mathematics ; skos:broader c:calculus .

c:chain-rule a skos:Concept ; skos:prefLabel "Chain rule"@en ;
    skos:inScheme scheme:mathematics ; skos:broader c:calculus .
