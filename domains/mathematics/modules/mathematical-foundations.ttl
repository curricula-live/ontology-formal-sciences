@prefix c: <https://curricula.live/id/formal-sciences/concept/> .
@prefix v: <https://curricula.live/id/formal-sciences/vocab/> .
@prefix scheme: <https://curricula.live/id/formal-sciences/scheme/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

c:mathematical-foundations a skos:Concept ; skos:prefLabel "Mathematical foundations"@en ;
    skos:inScheme scheme:mathematics ; skos:broader c:mathematics .

c:axiom a skos:Concept ; skos:prefLabel "Axiom"@en ;
    skos:inScheme scheme:mathematics ; skos:broader c:mathematical-foundations .

c:axiomatic-system a skos:Concept ; skos:prefLabel "Axiomatic system"@en ;
    skos:inScheme scheme:mathematics ; skos:broader c:mathematical-foundations .

c:formal-system a skos:Concept ; skos:prefLabel "Formal system"@en ;
    skos:inScheme scheme:mathematics ; skos:broader c:mathematical-foundations .

c:mathematical-proof a skos:Concept ; skos:prefLabel "Mathematical proof"@en ;
    skos:inScheme scheme:mathematics ; skos:broader c:mathematical-foundations .
