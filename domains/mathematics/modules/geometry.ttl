@prefix c: <https://curricula.live/id/formal-sciences/concept/> .
@prefix v: <https://curricula.live/id/formal-sciences/vocab/> .
@prefix scheme: <https://curricula.live/id/formal-sciences/scheme/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

c:geometry a skos:Concept ; skos:prefLabel "Geometry"@en ;
    skos:inScheme scheme:mathematics ; skos:broader c:mathematics .

c:euclidean-geometry a skos:Concept ; skos:prefLabel "Euclidean geometry"@en ;
    skos:inScheme scheme:mathematics ; skos:broader c:geometry .

c:affine-space a skos:Concept ; skos:prefLabel "Affine space"@en ;
    skos:inScheme scheme:mathematics ; skos:broader c:geometry .

c:convex-set a skos:Concept ; skos:prefLabel "Convex set"@en ;
    skos:inScheme scheme:mathematics ; skos:broader c:geometry .

c:euclidean-distance a skos:Concept ; skos:prefLabel "Euclidean distance"@en ;
    skos:inScheme scheme:mathematics ; skos:broader c:geometry .
