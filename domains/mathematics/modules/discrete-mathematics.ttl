@prefix c: <https://curricula.live/id/formal-sciences/concept/> .
@prefix v: <https://curricula.live/id/formal-sciences/vocab/> .
@prefix scheme: <https://curricula.live/id/formal-sciences/scheme/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

c:discrete-mathematics a skos:Concept ; skos:prefLabel "Discrete mathematics"@en ;
    skos:inScheme scheme:mathematics ; skos:broader c:mathematics .

c:recurrence-relation a skos:Concept ; skos:prefLabel "Recurrence relation"@en ;
    skos:inScheme scheme:mathematics ; skos:broader c:discrete-mathematics .

c:partial-order a skos:Concept ; skos:prefLabel "Partial order"@en ;
    skos:inScheme scheme:mathematics ; skos:broader c:discrete-mathematics .

c:lattice-order-theory a skos:Concept ; skos:prefLabel "Lattice (order theory)"@en ;
    skos:inScheme scheme:mathematics ; skos:broader c:discrete-mathematics .

c:boolean-algebra a skos:Concept ; skos:prefLabel "Boolean algebra"@en ;
    skos:inScheme scheme:mathematics ; skos:broader c:discrete-mathematics .
