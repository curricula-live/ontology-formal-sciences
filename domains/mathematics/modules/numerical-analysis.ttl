@prefix c: <https://curricula.live/id/formal-sciences/concept/> .
@prefix v: <https://curricula.live/id/formal-sciences/vocab/> .
@prefix scheme: <https://curricula.live/id/formal-sciences/scheme/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

c:numerical-analysis a skos:Concept ; skos:prefLabel "Numerical analysis"@en ;
    skos:inScheme scheme:mathematics ; skos:broader c:mathematics .

c:numerical-integration a skos:Concept ; skos:prefLabel "Numerical integration"@en ;
    skos:inScheme scheme:mathematics ; skos:broader c:numerical-analysis .

c:newton-s-method a skos:Concept ; skos:prefLabel "Newton's method"@en ;
    skos:inScheme scheme:mathematics ; skos:broader c:numerical-analysis .

c:round-off-error a skos:Concept ; skos:prefLabel "Round-off error"@en ;
    skos:inScheme scheme:mathematics ; skos:broader c:numerical-analysis .

c:condition-number a skos:Concept ; skos:prefLabel "Condition number"@en ;
    skos:inScheme scheme:mathematics ; skos:broader c:numerical-analysis .
