@prefix c: <https://curricula.live/id/formal-sciences/concept/> .
@prefix v: <https://curricula.live/id/formal-sciences/vocab/> .
@prefix scheme: <https://curricula.live/id/formal-sciences/scheme/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

c:numerical-analysis a skos:Concept ; skos:prefLabel "Numerical analysis"@en ;
    skos:inScheme scheme:mathematics ; skos:broader c:mathematics .

c:numerical-integration a skos:Concept ; skos:prefLabel "Numerical integration"@en ;
    skos:inScheme scheme:mathematics ; skos:broader c:numerical-analysis .

c:newton-s-method a skos:Concept ; skos:prefLabel "Newton's method"@en ;
    skos:inScheme scheme:mathematics ; skos:broader c:numerical-analysis .

c:round-off-error a skos:Concept ; skos:prefLabel "Round-off error"@en ;
    skos:inScheme scheme:mathematics ; skos:broader c:numerical-analysis .

c:condition-number a skos:Concept ; skos:prefLabel "Condition number"@en ;
    skos:inScheme scheme:mathematics ; skos:broader c:numerical-analysis .

c:conjugate-gradient-method a skos:Concept ; skos:prefLabel "Conjugate gradient method"@en ;
    skos:inScheme scheme:mathematics ; skos:broader c:numerical-analysis .

c:linear-least-squares-problem a skos:Concept ; skos:prefLabel "Linear least-squares problem"@en ;
    skos:inScheme scheme:mathematics ; skos:broader c:numerical-analysis ;
    skos:definition "The problem of minimizing the Euclidean norm of the residual of a linear system."@en .

c:qr-least-squares-method a skos:Concept ; skos:prefLabel "QR method for linear least squares"@en ;
    skos:inScheme scheme:mathematics ; skos:broader c:numerical-analysis ;
    skos:definition "A method that transforms a linear least-squares problem using an orthogonal factorization. In the full-column-rank case it recovers the unique solution by triangular substitution."@en .

c:normal-equations a skos:Concept ; skos:prefLabel "Normal equations"@en ;
    skos:inScheme scheme:mathematics ; skos:broader c:numerical-analysis ;
    skos:definition "The linear equations obtained by requiring a linear least-squares residual to be orthogonal to the column space of the design matrix."@en .

c:linear-system-solution a skos:Concept ; skos:prefLabel "Linear system solution problem"@en ;
    skos:inScheme scheme:mathematics ; skos:broader c:numerical-analysis ;
    skos:definition "The problem of finding a vector satisfying a specified system of linear equations."@en .

c:cholesky-factorization a skos:Concept ; skos:prefLabel "Cholesky factorization"@en ;
    skos:inScheme scheme:mathematics ; skos:broader c:numerical-analysis ;
    skos:definition "A factorization of a positive definite Hermitian matrix as a triangular matrix times its conjugate transpose, with positive diagonal entries."@en .
