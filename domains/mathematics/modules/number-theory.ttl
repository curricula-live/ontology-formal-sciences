@prefix c: <https://curricula.live/id/formal-sciences/concept/> .
@prefix v: <https://curricula.live/id/formal-sciences/vocab/> .
@prefix scheme: <https://curricula.live/id/formal-sciences/scheme/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

c:number-theory a skos:Concept ; skos:prefLabel "Number theory"@en ;
    skos:inScheme scheme:mathematics ; skos:broader c:mathematics .

c:prime-number a skos:Concept ; skos:prefLabel "Prime number"@en ;
    skos:inScheme scheme:mathematics ; skos:broader c:number-theory .

c:divisibility a skos:Concept ; skos:prefLabel "Divisibility"@en ;
    skos:inScheme scheme:mathematics ; skos:broader c:number-theory .

c:modular-arithmetic a skos:Concept ; skos:prefLabel "Modular arithmetic"@en ;
    skos:inScheme scheme:mathematics ; skos:broader c:number-theory .

c:greatest-common-divisor a skos:Concept ; skos:prefLabel "Greatest common divisor"@en ;
    skos:inScheme scheme:mathematics ; skos:broader c:number-theory .
