@prefix c: <https://curricula.live/id/formal-sciences/concept/> .
@prefix v: <https://curricula.live/id/formal-sciences/vocab/> .
@prefix scheme: <https://curricula.live/id/formal-sciences/scheme/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

c:set-theory a skos:Concept ; skos:prefLabel "Set theory"@en ;
    skos:inScheme scheme:mathematics ; skos:broader c:mathematics .

c:set a skos:Concept ; skos:prefLabel "Set"@en ;
    skos:inScheme scheme:mathematics ; skos:broader c:set-theory .

c:subset a skos:Concept ; skos:prefLabel "Subset"@en ;
    skos:inScheme scheme:mathematics ; skos:broader c:set-theory .

c:power-set a skos:Concept ; skos:prefLabel "Power set"@en ;
    skos:inScheme scheme:mathematics ; skos:broader c:set-theory .

c:cartesian-product a skos:Concept ; skos:prefLabel "Cartesian product"@en ;
    skos:inScheme scheme:mathematics ; skos:broader c:set-theory .

c:set-intersection a skos:Concept ; skos:prefLabel "Set intersection"@en ;
    skos:inScheme scheme:mathematics ; skos:broader c:set-theory .

c:function a skos:Concept ; skos:prefLabel "Function (mathematics)"@en ;
    skos:definition "A mapping that assigns exactly one output to each element of its domain."@en ;
    skos:inScheme scheme:mathematics ; skos:broader c:set-theory .

c:ultrafilter a skos:Concept ; skos:prefLabel "Ultrafilter"@en ;
    skos:inScheme scheme:mathematics ; skos:broader c:set-theory ;
    skos:definition "A maximal proper filter of subsets of a set. For each subset, exactly one of it and its complement belongs to the filter."@en .

c:set-partition a skos:Concept ; skos:prefLabel "Partition of a set"@en ;
    skos:inScheme scheme:mathematics ; skos:broader c:set-theory ;
    skos:definition "A family of pairwise disjoint nonempty subsets whose union is the original set."@en .

c:monotone-map a skos:Concept ; skos:prefLabel "Monotone map of partially ordered sets"@en ;
    skos:inScheme scheme:mathematics ; skos:broader c:partial-order ;
    skos:definition "A map preserving the order relation between comparable elements."@en .

c:complete-lattice a skos:Concept ; skos:prefLabel "Complete lattice"@en ;
    skos:inScheme scheme:mathematics ; skos:broader c:lattice-order-theory ;
    skos:definition "A partially ordered set in which every subset has both a supremum and an infimum."@en .

c:knaster-tarski-fixed-point-theorem a skos:Concept ; skos:prefLabel "Knaster–Tarski fixed-point theorem"@en ;
    skos:inScheme scheme:mathematics ; skos:broader c:lattice-order-theory ;
    skos:definition "The fixed points of a monotone self-map of a complete lattice form a complete lattice, with extrema in the original order."@en .

c:galois-connection a skos:Concept ; skos:prefLabel "Galois connection between partially ordered sets"@en ;
    skos:inScheme scheme:mathematics ; skos:broader c:partial-order ;
    skos:definition "A pair of monotone maps between partially ordered sets such that the left map applied to x is below y exactly when x is below the right map applied to y."@en .

c:greatest-fixed-point a skos:Concept ; skos:prefLabel "Greatest fixed point"@en ;
    skos:inScheme scheme:mathematics ; skos:broader c:knaster-tarski-fixed-point-theorem ;
    skos:definition "A fixed point of an order-preserving map that is above every other fixed point in the underlying order."@en .

c:least-fixed-point a skos:Concept ; skos:prefLabel "Least fixed point"@en ;
    skos:inScheme scheme:mathematics ; skos:broader c:knaster-tarski-fixed-point-theorem ;
    skos:definition "A fixed point of an order-preserving map that is below every other fixed point in the underlying order."@en .
