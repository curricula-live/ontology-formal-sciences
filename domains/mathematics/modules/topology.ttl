@prefix c: <https://curricula.live/id/formal-sciences/concept/> .
@prefix v: <https://curricula.live/id/formal-sciences/vocab/> .
@prefix scheme: <https://curricula.live/id/formal-sciences/scheme/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

c:topology a skos:Concept ; skos:prefLabel "Topology"@en ;
    skos:inScheme scheme:mathematics ; skos:broader c:mathematics .

c:topological-space a skos:Concept ; skos:prefLabel "Topological space"@en ;
    skos:inScheme scheme:mathematics ; skos:broader c:topology .

c:open-set a skos:Concept ; skos:prefLabel "Open set"@en ;
    skos:inScheme scheme:mathematics ; skos:broader c:topology .

c:compactness-topology a skos:Concept ; skos:prefLabel "Compactness (topology)"@en ;
    skos:inScheme scheme:mathematics ; skos:broader c:topology .

c:homeomorphism a skos:Concept ; skos:prefLabel "Homeomorphism"@en ;
    skos:inScheme scheme:mathematics ; skos:broader c:topology .
