@prefix c: <https://curricula.live/id/formal-sciences/concept/> .
@prefix v: <https://curricula.live/id/formal-sciences/vocab/> .
@prefix scheme: <https://curricula.live/id/formal-sciences/scheme/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

c:topology a skos:Concept ; skos:prefLabel "Topology"@en ;
    skos:inScheme scheme:mathematics ; skos:broader c:mathematics .

c:topological-space a skos:Concept ; skos:prefLabel "Topological space"@en ;
    skos:inScheme scheme:mathematics ; skos:broader c:topology .

c:open-set a skos:Concept ; skos:prefLabel "Open set"@en ;
    skos:inScheme scheme:mathematics ; skos:broader c:topology .

c:compactness-topology a skos:Concept ; skos:prefLabel "Compactness (topology)"@en ;
    skos:inScheme scheme:mathematics ; skos:broader c:topology .

c:homeomorphism a skos:Concept ; skos:prefLabel "Homeomorphism"@en ;
    skos:inScheme scheme:mathematics ; skos:broader c:topology .

c:algebraic-topology a skos:Concept ; skos:prefLabel "Algebraic topology"@en ;
    skos:inScheme scheme:mathematics ; skos:broader c:topology ;
    skos:definition "The study of topological spaces through algebraic constructions and invariants."@en .

c:based-loop a skos:Concept ; skos:prefLabel "Based loop"@en ;
    skos:inScheme scheme:mathematics ; skos:broader c:algebraic-topology ;
    skos:definition "A continuous path starting and ending at a chosen point in a space."@en .

c:loop-homotopy a skos:Concept ; skos:prefLabel "Based loop homotopy"@en ;
    skos:inScheme scheme:mathematics ; skos:broader c:algebraic-topology ;
    skos:definition "A continuous deformation between based loops that fixes the chosen point along both ends of the paths throughout the deformation."@en .

c:simplicial-chain-complex a skos:Concept ; skos:prefLabel "Simplicial chain complex"@en ;
    skos:inScheme scheme:mathematics ; skos:broader c:algebraic-topology ;
    skos:definition "A chain complex whose groups are generated by oriented simplices and whose differentials take alternating sums of faces."@en .

c:simplicial-boundary-map a skos:Concept ; skos:prefLabel "Simplicial boundary map"@en ;
    skos:inScheme scheme:mathematics ; skos:broader c:simplicial-chain-complex ;
    skos:definition "The group homomorphism sending an oriented simplex to the alternating sum of its oriented codimension-one faces."@en .

c:simplicial-homology a skos:Concept ; skos:prefLabel "Simplicial homology"@en ;
    skos:inScheme scheme:mathematics ; skos:broader c:algebraic-topology ;
    skos:definition "Homology obtained in each degree by quotienting the kernel of the simplicial boundary by the image of the next boundary."@en .

c:betti-number a skos:Concept ; skos:prefLabel "Betti number"@en ;
    skos:inScheme scheme:mathematics ; skos:broader c:algebraic-topology ;
    skos:definition "The rank of a homology group in a given degree, or its dimension when computed over a field."@en .

c:euler-characteristic a skos:Concept ; skos:prefLabel "Euler characteristic"@en ;
    skos:inScheme scheme:mathematics ; skos:broader c:algebraic-topology ;
    skos:definition "For a finite simplicial complex, the alternating sum of the numbers of simplices by dimension, equal to the alternating sum of its Betti numbers."@en .
