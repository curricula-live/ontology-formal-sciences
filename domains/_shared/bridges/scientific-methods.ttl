@prefix c: <https://curricula.live/id/formal-sciences/concept/> .
@prefix v: <https://curricula.live/id/formal-sciences/vocab/> .
@prefix scheme: <https://curricula.live/id/formal-sciences/scheme/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

c:dijkstra-s-algorithm v:requiresAssumption c:nonnegative-edge-weights .
c:dijkstra-s-algorithm v:uses c:weighted-graph .
c:bellman-ford-algorithm v:uses c:weighted-graph .
c:edge-relaxation v:uses c:graph-edge .
c:breadth-first-search v:uses c:graph-vertex .
c:depth-first-search v:uses c:graph-vertex .
c:two-sat-implication-graph-algorithm v:uses c:strongly-connected-component .
c:two-sat-implication-graph-algorithm v:uses c:directed-graph .
c:boolean-satisfiability v:hasProperty c:np-completeness .
c:three-satisfiability v:hasProperty c:np-completeness .
c:automata-theoretic-ltl-model-checking v:uses c:buchi-automaton .
c:ordinary-least-squares v:solves c:linear-least-squares-problem .
c:ridge-regression v:uses c:quadratic-form .
c:factor-graph v:represents c:joint-distribution .
c:conditional-entropy v:uses c:conditional-distribution .
c:mutual-information v:uses c:joint-distribution .
c:mutual-information v:uses c:product-of-marginals .
c:kullback-leibler-divergence v:uses c:expected-value .
c:forward-mode-automatic-differentiation v:uses c:chain-rule .
c:tree-sum-product v:computes c:marginal-distribution .
c:qr-least-squares-method v:uses c:design-matrix .
c:normal-equations v:uses c:design-matrix .
c:conditional-mutual-information v:uses c:conditional-distribution .
c:bellman-ford-algorithm v:requiresAssumption c:no-reachable-negative-cycle .

c:ctl-state-labeling-algorithm v:uses c:fixed-point .
