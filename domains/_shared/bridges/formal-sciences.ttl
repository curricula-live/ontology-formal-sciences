c:static-program-analysis skos:related c:formal-verification .
c:type-inference skos:related c:typing-judgment .
c:simply-typed-lambda-calculus skos:broader c:lambda-calculus .
c:principal-component-analysis skos:related c:singular-value-decomposition .
c:shannon-entropy v:uses c:probability-distributions .
c:markov-chain skos:related c:directed-graph .
c:gradient-descent v:uses c:derivative .
c:minimum-spanning-tree-problem v:hasInputStructure c:weighted-graph .
c:minimum-spanning-tree-problem skos:related c:spanning-tree .
c:maximum-flow-problem skos:related c:directed-graph .
c:adjacency-list skos:related c:data-structures .
c:probabilistic-graphical-model v:uses c:graph-graph-theory .
c:transition-matrix v:uses c:matrix .
c:least-squares skos:related c:orthogonal-projection .
c:principal-component-analysis skos:related c:eigenvector .
c:backpropagation v:uses c:chain-rule .
c:fixed-point-semantics v:uses c:fixed-point .
